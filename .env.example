APS_CLIENT_ID=
APS_CLIENT_SECRET=

# Shown in Design Automation activity IDs (e.g. Phamtec.BatchExportActivity+dev)
APS_NICKNAME=

# OSS bucket for input uploads and exported zip output
APS_BUCKET_KEY=batch-export-output

# Region for Design Automation and OSS (default: us-east)
APS_REGION=us-east

# OAuth callback for one-time Fusion Team sign-in (npm run auth)
APS_CALLBACK_URL=http://localhost:8080/callback/oauth

# Optional: default Fusion Team target for hub-based export (npm run export)
APS_HUB_ID=
APS_FILE_URN=

# Optional: override 3-legged OAuth scopes
# APS_3LO_SCOPES=data:read data:write data:create account:read
