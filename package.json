{
  "name": "batch-export",
  "version": "1.0.0",
  "private": true,
  "type": "module",
    "scripts": {
        "auth": "tsx scripts/aps-auth.ts",
        "appbundle": "tsx scripts/create-appbundle.ts",
        "activity": "tsx scripts/create-activity.ts",
        "export": "tsx scripts/create-workitem.ts",
        "build:lambda": "esbuild scripts/lambda-handler.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/lambda/index.js",
        "deploy:lambda": "tsx scripts/deploy-lambda.ts"
    },
    "devDependencies": {
        "@types/node": "^22.10.0",
        "dotenv": "^16.4.7",
        "esbuild": "^0.25.0",
        "tsx": "^4.19.2",
        "typescript": "^5.7.2"
    }
}
